# Copie para .env.local e preencha. NUNCA coloque a service_role aqui (vai para o navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Modo público (opcional): o site entra sozinho com esta conta e ninguém precisa fazer login.
# ATENÇÃO: com isto preenchido, qualquer pessoa com o link vê e altera todos os dados.
# Configure na Vercel (Settings > Environment Variables), não no repositório.
VITE_PUBLIC_EMAIL=
VITE_PUBLIC_PASSWORD=
